rules_version = '2';

// BoardHub keeps everything under users/{uid}/boardhub/* (legacy docs `state`,
// `notes`, `gallery`, the v4 control doc `sync-v4` and the v4 entity docs).
// Only the signed-in owner may touch them; nothing else is readable.
// Firestore itself caps a document at 1 MiB, which the app already respects
// (950 KB legacy / 850 KB per v4 entity).
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid}/boardhub/{docId} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // Once `sync-v4` exists the account is on per-item sync and the legacy
      // documents are frozen rollback inputs: a write from a stale client would be
      // invisible to every other device. `rules-canary-v2` is never writable: the
      // app tries to write it once, and a refusal tells it these rules are live
      // (only then does it switch an account to per-item sync by itself).
      allow write: if request.auth != null && request.auth.uid == uid
        && docId != 'rules-canary-v2'
        && !(docId in ['state', 'notes', 'gallery']
             && exists(/databases/$(database)/documents/users/$(uid)/boardhub/sync-v4));
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
