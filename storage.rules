rules_version = '2';

// Uploads are content-addressed: users/{uid}/images/sha256_<digest>_<mime>
// (plus "_thumb480" and "_disp1280" derivatives; the latter is a WebP copy
// that fits 1280×720 for the full-screen view; older "_disp2880" copies may
// still exist). The current rules already allow these names. Limits mirror BH_MEDIA in index.html:
// images are kept as uploaded, GIF <= 15 MB, video <= 60 MB.
//
// NOTE: getDownloadURL() links carry an access token and are readable by
// anyone who has the URL, regardless of the `read` rule below. The rule only
// protects direct SDK reads. Treat the URLs as secrets and consider App Check.
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/images/{file} {
      allow read: if request.auth != null && request.auth.uid == uid;
      // create only: objects are content-addressed and never rewritten, so an
      // overwrite (a client bug, two tabs racing) is refused instead of replacing
      // an original or invalidating the download links other devices hold.
      allow create: if request.auth != null && request.auth.uid == uid
        // Older uploads (img_<time>_<random>.<ext>) may get the same two
        // derivatives; the originals themselves are never created again.
        && (file.matches('sha256_[0-9a-f]{64}_.*')
            || file.matches('img_[0-9]+_[a-z0-9]+[.][a-z]+_(thumb480|disp1280)'))
        && request.resource.size <= 60 * 1024 * 1024
        && (request.resource.contentType.matches('image/.*')
            || request.resource.contentType.matches('video/.*')
            // uploadToFirebaseStorage() falls back to this when the browser
            // reports no type for a file.
            || request.resource.contentType == 'application/octet-stream');
      allow delete: if request.auth != null && request.auth.uid == uid;
    }
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
